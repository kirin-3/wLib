{
  "include": [
    "main.py",
    "core",
    "catalog_server"
  ],
  "exclude": [
    "tests",
    "ui/node_modules",
    "ui/dist",
    "build",
    "dist",
    "node_modules",
    ".venv",
    "venv"
  ],
  "venvPath": ".",
  "venv": ".venv",
  "stubPath": "typings",
  "extraPaths": [
    "typings"
  ],
  "pythonVersion": "3.12",
  "pythonPlatform": "Linux",
  "typeCheckingMode": "recommended",
  "strict": [
    "core/api.py",
    "core/api_mixins",
    "core/app_version.py",
    "core/bridge_exposure.py",
    "core/database.py",
    "core/extension_server.py",
    "core/launcher.py",
    "core/scraper.py",
    "main.py"
  ],
  "reportMissingTypeStubs": false
}
