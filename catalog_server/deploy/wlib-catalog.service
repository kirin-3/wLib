[Unit]
Description=Build and publish the wLib game catalog
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=wlibcat
Group=wlibcat
WorkingDirectory=/opt/wlib-catalog
Environment=WLIB_CATALOG_DATA_DIR=/var/lib/wlib-catalog
Environment=PYTHONUNBUFFERED=1
Environment=PLAYWRIGHT_BROWSERS_PATH=/opt/wlib-catalog/.browsers
EnvironmentFile=/etc/wlib-catalog/r2.env
# Optional settings such as WLIB_CATALOG_DLSITE_PROXY and WLIB_CATALOG_BROWSER_SITES.
EnvironmentFile=-/etc/wlib-catalog/catalog.env
# Optional F95 login: WLIB_CATALOG_F95_COOKIE (root 0600).
EnvironmentFile=-/etc/wlib-catalog/f95.env
# Optional LewdCorner login: WLIB_CATALOG_LC_COOKIE (root 0600); needs lc in WLIB_CATALOG_BROWSER_SITES.
EnvironmentFile=-/etc/wlib-catalog/lc.env
# Optional run reports: WLIB_CATALOG_DISCORD_WEBHOOK (root 0600).
EnvironmentFile=-/etc/wlib-catalog/discord.env
ExecStart=/opt/wlib-catalog/.venv/bin/python -m catalog_server run
TimeoutStartSec=3h
# Headroom for the headless Chromium of WLIB_CATALOG_BROWSER_SITES.
MemoryMax=2G
Nice=10

ProtectSystem=strict
ReadWritePaths=/var/lib/wlib-catalog
PrivateTmp=true
NoNewPrivileges=true
ProtectHome=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
