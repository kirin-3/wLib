{
    "manifest_version": 3,
    "name": "wLib",
    "version": "1.1.2",
    "description": "Send F95Zone games directly to your native wLib game manager.",
    "permissions": ["storage", "alarms"],
    "host_permissions": [
        "http://localhost:8183/*",
        "https://f95zone.to/*"
    ],
    "background": {
        "service_worker": "background.js",
        "scripts": [
            "background.js"
        ],
        "type": "module"
    },
    "browser_specific_settings": {
        "gecko": {
            "id": "wlib@thekirin.net",
            "strict_min_version": "140.0",
            "update_url": "https://github.com/kirin-3/wLib/releases/latest/download/updates.json",
            "data_collection_permissions": {
                "required": [
                    "none"
                ]
            }
        },
        "gecko_android": {
            "strict_min_version": "142.0"
        }
    },
    "content_scripts": [
        {
            "matches": [
                "*://f95zone.to/threads/*",
                "*://f95zone.to/sam/latest_alpha*"
            ],
            "css": [
                "content.css"
            ],
            "js": [
                "content.js"
            ]
        }
    ],
    "web_accessible_resources": [
        {
            "resources": [
                "icon.svg",
                "arrow-down-left.svg",
                "library-plus.svg",
                "external-link.svg"
            ],
            "matches": [
                "*://f95zone.to/*"
            ]
        }
    ],
    "icons": {
        "48": "icon-48.png",
        "128": "icon-128.png"
    },
    "action": {
        "default_icon": "icon-48.png",
        "default_title": "wLib Integration"
    }
}
